<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required under the hardened runtime to read calendars through EventKit (the calendar
         widget). Without it macOS refuses access without showing the Calendars prompt. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
</dict>
</plist>
